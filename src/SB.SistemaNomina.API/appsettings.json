{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/nomina-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Persistencia": {
    "Proveedor": "Json"
  },
  "ConnectionStrings": {
    "BaseDatosJson": "BaseDatos"
  },
  "Autenticacion": {
    "Emisor": "SB.SistemaNomina",
    "Audiencia": "SB.SistemaNomina.Frontend",
    "ClaveFirma": "",
    "DuracionTokenMinutos": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:5173" ]
  },
  "LimiteSolicitudes": {
    "General": {
      "PermisosPorVentana": 100,
      "VentanaSegundos": 60
    },
    "InicioSesion": {
      "PermisosPorVentana": 5,
      "VentanaSegundos": 60
    }
  },
  "DatosIniciales": {
    "NombreUsuarioAdministrador": "admin",
    "NombreUsuarioConsulta": "consulta",
    "IncluirEmpleadosDemostracion": false
  }
}
